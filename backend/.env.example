# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT="https://aoai-arei.openai.azure.com/"
AZURE_OPENAI_API_KEY="<tu-clave>"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"

# --- Ajustes del modelo (opcionales) ---
CAMI_TEMPERATURE="0.4"
CAMI_MAX_TOKENS="220"
CAMI_MAX_HISTORY="12"

# --- CORS: orígenes del frontend separados por coma ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
